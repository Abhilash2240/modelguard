# =============================================================================
# MODELGUARD CONFIGURATION
# =============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
BASE_DIR=/app

# Storage and Database
STORAGE_DIR=/app/storage
DATASETS_DIR=/app/storage/datasets
DATABASE_URL=sqlite:////app/storage/modelguard.db

# MLflow Experiment Tracking & Registry
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=metro-traffic-volume-prod
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
MLFLOW_MODEL_NAME=metro-traffic-volume

# Prometheus & Metrics
PROMETHEUS_METRICS_PATH=/metrics

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80
