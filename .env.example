# =============================================================================
# MODELGUARD CONFIGURATION
# =============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
BASE_DIR=/app

# Storage and Database
STORAGE_DIR=/app/storage
DATASETS_DIR=/app/storage/datasets
DATABASE_URL=sqlite:////app/storage/modelguard.db

# MLflow Experiment Tracking & Registry
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=metro-traffic-volume-prod
MLFLOW_ARTIFACT_ROOT=file:///mlflow/artifacts
MLFLOW_MODEL_NAME=metro-traffic-volume

# Prometheus & Metrics
PROMETHEUS_METRICS_PATH=/metrics

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80

# Security & Authentication Configuration
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_hex_key_at_least_32_chars

# Bootstrap Initial Administrator (auto-created on first database initialization)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Grafana Security Configuration
# Set a strong password for the Grafana admin user before launching Docker Compose
GRAFANA_ADMIN_PASSWORD=change_this_to_a_secure_password
